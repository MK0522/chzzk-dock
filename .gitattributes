# Auto detect text files and perform LF normalization
* text=auto

# Ensure code and web files use LF
*.go text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf

# Binary files
*.ico binary
*.syso binary
*.exe binary
